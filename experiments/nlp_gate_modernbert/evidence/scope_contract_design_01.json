  "frozen_contract": {
    "Q1_top_level_program_contract": {
      "NormalizedProgram": "top-level composition unit",
      "NormalizedTask": "task_id + request + depends_on + produces_binds",
      "NormalizedRequest": "single-operation payload only; no clauses/dependencies inside request",
      "invariant": "NormalizedProgram owns composition; NormalizedRequest owns one semantic operation; ProjectedWorkspace owns evolving state; MB-02R remains per-task adjudicator"
    },
    "Q2_order_and_dependencies": {
      "tasks_array_order": "authoritative execution order",
      "depends_on": "explicit linear state/data edges; serialize resolved deps",
      "default": "missing depends_on may default to previous task then must be serialized",
      "out_of_scope": [
        "parallel",
        "fan-out",
        "fan-in",
        "concurrent",
        "conditional",
        "loops",
        "runtime graph scheduling"
      ],
      "contradiction_rule": "array order and depends_on must never contradict → DETERMINISTIC_SCHEMA_DOMAIN"
    },
    "Q3_projected_effect_surface": {
      "authorized": {
        "CREATE_TRACK": "append TrackFact; program-local projected ref via produces_binds",
        "PLACE_CURVE": "update track_ref / membership",
        "CONFIGURE_CURVE_DISPLAY": "scale_kind, scale_min, scale_max, scale_reverse only",
        "DEFINE_FILL": "deferred unless later task must observe fill",
        "REMOVE_FILL": "deferred unless required"
      },
      "effect_only_after_OK": true,
      "no_document_simulation": true,
      "no_silent_broadening": "report missing effect requirement; do not add because WELL-IR supports the op"
    },
    "Q4_local_bind_semantics": {
      "SemanticQuery": "exactly one of text | local_ref",
      "produces_binds_on_task": true,
      "LocalBindingTable": "execution state alongside ProjectedWorkspace; not mutating declarative NormalizedProgram.binds",
      "bind_contract_failures": "DETERMINISTIC_SCHEMA_DOMAIN (not NOT_FOUND)",
      "visibility": "consume only binds from earlier successful tasks in dependency ancestry"
    },
    "Q5_program_terminal_semantics": {
      "program_structure_validation_first": true,
      "fail_fast": true,
      "first_non_OK_is_terminal": true,
      "all_OK": {
        "status": "ok",
        "reason": null,
        "authority": "OK"
      },
      "no_partial_success_public_status": true,
      "task_history_diagnostic_only": true
    }
  },
  "epistemic_claim": "This slice establishes only whether the six cases are representable under NormalizedProgram + deterministic projected-state semantics. It does not establish raw English → NormalizedProgram.",
