        {
            "id": "page_output_depth_settings",
            "kind": "revise",
            "status": "active",
            "initial_state": {
                "fixture": "open_hole_initial_draft",
                "preconditions": [
                    {"path": "/sections", "operator": "contains_object", "value": {"id": "main"}},
                    {"path": "/page/orientation", "operator": "equals", "value": "portrait"}
                ]
            },
            "feedback": "Set the report to landscape A3 continuous layout. Set output DPI to 240. Set the depth axis to ft at 1:200 with 20 ft major and 5 ft minor steps. Set section `main` depth range to 8400 to 9300. Do not alter header, remarks, tracks, or bindings.",
            "expected": [
                {"path": "/page/size", "operator": "equals", "value": "A3"},
                {"path": "/page/orientation", "operator": "equals", "value": "landscape"},
                {"path": "/page/continuous", "operator": "equals", "value": true},
                {"path": "/output/dpi", "operator": "equals", "value": 240},
                {"path": "/depth/scale", "operator": "equals", "value": "1:200"},
                {"path": "/depth/major_step", "operator": "equals", "value": 20.0},
                {"path": "/depth/minor_step", "operator": "equals", "value": 5.0},
                {
                    "path": "/sections",
                    "operator": "contains_object",
                    "value": {"id": "main", "depth_range": [8400.0, 9300.0]}
                }
            ],
            "allowed_change_paths": ["/page", "/output", "/depth", "/sections/0/depth_range"],
            "prohibited_change_paths": ["/header", "/remarks", "/sections/0/tracks"]
