{
    "suite": "development",
    "version": 2,
    "tasks": [
        {
            "id": "initial_open_hole",
            "kind": "run",
            "status": "active",
            "initial_state": {
                "fixture": "open_hole_clean_starter",
                "preconditions": [
                    {"path": "/sections", "operator": "length", "value": 1},
                    {
                        "path": "/sections",
                        "operator": "contains_object",
                        "value": {
                            "id": "main",
                            "tracks": [{"id": "gr_sp"}, {"id": "depth", "kind": "reference"}]
                        }
                    },
                    {"path": "/remarks", "operator": "length", "value": 0}
                ]
            },
            "goal": "Start from the existing open-hole starter. Keep section `main`, set its subtitle to `Interactive LAS tutorial draft`, preserve `gr_sp` before `depth`, preserve the open-hole header archetype, fill only available LAS metadata, set the first service title to `Open Hole Quicklook`, and add no remarks or tracks.",
            "expected": [
                {"path": "/sections", "operator": "length", "value": 1},
                {
                    "path": "/sections",
                    "operator": "contains_object",
                    "value": {
                        "id": "main",
                        "subtitle": "Interactive LAS tutorial draft",
                        "tracks": [{"id": "gr_sp"}, {"id": "depth", "kind": "reference"}]
                    }
                },
                {"path": "/header/detail/kind", "operator": "equals", "value": "open_hole"},
                {
                    "path": "/header/service_titles",
                    "operator": "contains_object",
                    "value": {
                        "slot_id": "service_title.1",
                        "value": {"value": "Open Hole Quicklook"}
                    }
                },
                {"path": "/remarks", "operator": "length", "value": 0}
            ],
            "allowed_change_paths": ["/sections/0/subtitle", "/header"],
            "prohibited_change_paths": ["/page", "/depth", "/output", "/remarks"]
        },
        {
            "id": "remarks_only",
            "kind": "revise",
            "status": "active",
            "initial_state": {
                "fixture": "open_hole_initial_draft",
                "preconditions": [
                    {"path": "/sections", "operator": "contains_object", "value": {"id": "main"}},
                    {"path": "/remarks", "operator": "length", "value": 0}
                ]
            },
            "feedback": "Add one concise first-page remarks block. It must say this is an open-hole quicklook built from a user-supplied LAS file, that only channels confirmed through source inspection should be plotted, and that the packet is an iterative interpretation artifact rather than a vendor-issued original.",
            "expected": [
                {"path": "/remarks", "operator": "length", "value": 1},
                {"path": "/remarks", "operator": "contains_ci", "value": "open-hole quicklook"},
                {"path": "/remarks", "operator": "contains_ci", "value": "user-supplied LAS"},
                {
                    "path": "/remarks",
                    "operator": "contains_ci",
                    "value": "iterative interpretation artifact"
                }
            ],
            "allowed_change_paths": ["/remarks"],
            "prohibited_change_paths": ["/sections", "/header", "/page", "/depth", "/output"]
        },
        {
            "id": "natural_language_header_fill",
            "kind": "revise",
            "status": "active",
            "initial_state": {
                "fixture": "open_hole_header_starter",
                "preconditions": [
                    {
                        "path": "/header/detail/rows",
                        "operator": "contains_object",
                        "value": {"key": "rm_measured_temp"}
                    },
                    {
                        "path": "/header/detail/rows",
                        "operator": "contains_object",
                        "value": {"key": "rm_bottom_temp"}
                    }
                ]
            },
            "feedback": "Set header RM at measured temperature to `0.005 @ 35` and header RM at bottom temperature to `0.010 @ 100`. Do not infer or change any other header value.",
            "expected": [
                {
                    "path": "/header/detail/rows",
                    "operator": "contains_object",
                    "value": {
                        "key": "rm_measured_temp",
                        "columns": [
                            {
                                "cells": [
                                    {"value": {"value": "0.005"}},
                                    {"value": {"value": "@"}},
                                    {"value": {"value": "35"}}
                                ]
                            }
                        ]
                    }
                },
                {
                    "path": "/header/detail/rows",
                    "operator": "contains_object",
                    "value": {
                        "key": "rm_bottom_temp",
                        "columns": [
                            {
                                "cells": [
                                    {"value": {"value": "0.010"}},
                                    {"value": {"value": "@"}},
                                    {"value": {"value": "100"}}
                                ]
                            }
                        ]
                    }
                }
            ],
            "allowed_change_paths": ["/header/detail/rows"],
            "prohibited_change_paths": ["/sections", "/remarks", "/page", "/depth", "/output"]
        },
        {
            "id": "sp_overview_curve",
            "kind": "revise",
            "status": "active",
            "initial_state": {
                "fixture": "open_hole_gr_sp_seed",
                "preconditions": [
                    {
                        "path": "/sections",
                        "operator": "contains_object",
                        "value": {
                            "id": "main",
                            "tracks": [
                                {"id": "gr_sp", "bindings": [{"channel": "GR"}]},
                                {"id": "depth", "kind": "reference"}
                            ]
                        }
                    }
                ]
            },
            "feedback": "On the existing `gr_sp` track, add SP when available. Set SP to a linear scale from -80 to 20 mV. Keep GR on a readable green linear scale. Do not alter the depth track or create a new track.",
            "expected": [
                {
                    "path": "/sections/0/tracks",
                    "operator": "contains_object",
                    "value": {
                        "id": "gr_sp",
                        "bindings": [
                            {"channel": "GR", "style": {"color": "#008000"}},
                            {
                                "channel": "SP",
                                "scale": {"kind": "linear", "minimum": -80.0, "maximum": 20.0}
                            }
                        ]
                    }
                }
            ],
            "allowed_change_paths": ["/sections/0/tracks/0"],
            "prohibited_change_paths": [
                "/sections/0/tracks/1",
                "/header",
                "/remarks",
                "/page",
                "/depth",
                "/output"
            ]
        },
        {
