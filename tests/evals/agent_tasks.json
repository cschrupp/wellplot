        {
            "id": "flexible_main_repeat_sections",
            "kind": "run",
            "status": "active",
            "initial_state": {
                "fixture": "cased_hole_main_starter",
                "preconditions": [
                    {"path": "/sections", "operator": "length", "value": 1},
                    {
                        "path": "/sections",
                        "operator": "contains_object",
                        "value": {"id": "main_pass"}
                    }
                ]
            },
            "goal": "Starting with main section `main_pass`, create a second section `repeat_pass` with its own data source. Both sections must contain `combo`, `depth`, `cbl`, and `vdl` tracks, including two distinct CBL scalar bindings and one VDL raster binding. Use generic section and track operations; do not depend on a packet-specific route.",
            "expected": [
                {"path": "/sections", "operator": "length", "value": 2},
                {
                    "path": "/sections",
                    "operator": "contains_object",
                    "value": {
                        "id": "main_pass",
                        "tracks": [
                            {"id": "combo"},
                            {"id": "depth", "kind": "reference"},
                            {"id": "cbl", "bindings": [{"channel": "CBL"}, {"channel": "CBL"}]},
                            {
                                "id": "vdl",
                                "kind": "array",
                                "bindings": [{"kind": "raster", "channel": "VDL"}]
                            }
                        ]
                    }
                },
                {
                    "path": "/sections",
                    "operator": "contains_object",
                    "value": {
                        "id": "repeat_pass",
                        "data_source": {"source_format": "dlis"},
                        "tracks": [
                            {"id": "combo"},
                            {"id": "depth", "kind": "reference"},
                            {"id": "cbl", "bindings": [{"channel": "CBL"}, {"channel": "CBL"}]},
                            {
                                "id": "vdl",
                                "kind": "array",
                                "bindings": [{"kind": "raster", "channel": "VDL"}]
                            }
                        ]
                    }
                }
            ],
            "allowed_change_paths": ["/sections", "/header", "/remarks"],
            "prohibited_change_paths": ["/page", "/depth", "/output"]
