                        "value": {
                            "id": "main",
                            "tracks": [{"id": "gr_sp"}, {"id": "depth", "kind": "reference"}]
                        }
                    }
                ]
            },
            "feedback": "Add one resistivity track after depth. Use a logarithmic 0.2 to 2000 ohm.m scale. Bind available deep, medium, and shallow resistivity curves. Give the deep curve a 1.2 line width and all other resistivity curves a line width no greater than 0.9.",
            "expected": [
