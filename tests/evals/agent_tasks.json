                    "path": "/sections/0/tracks",
                    "operator": "contains_object",
                    "value": {
                        "id": "resistivity",
                        "kind": "normal",
                        "x_scale": {"kind": "log", "minimum": 0.2, "maximum": 2000.0},
                        "bindings": [
                            {
                                "channel": "ILD",
                                "scale": {"kind": "log", "minimum": 0.2, "maximum": 2000.0},
                                "style": {"line_width": 1.2}
                            },
                            {
                                "channel": "ILM",
                                "scale": {"kind": "log", "minimum": 0.2, "maximum": 2000.0}
                            },
                            {
                                "channel": "MSFL",
                                "scale": {"kind": "log", "minimum": 0.2, "maximum": 2000.0}
                            }
                        ]
                    }
                }
            ],
            "allowed_change_paths": ["/sections/0/tracks"],
            "prohibited_change_paths": ["/header", "/remarks", "/page", "/depth", "/output"]
        },
