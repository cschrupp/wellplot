                    }
                ]
            },
            "feedback": "Add an array track `vdl` after the CBL track. Bind available VDL as a raster with VDL profile, grayscale reversed colormap, and a linear sample axis from 200 to 1200 us. Do not add a scalar surrogate for VDL.",
            "expected": [
                {
                    "path": "/sections/0/tracks",
                    "operator": "contains_object",
                    "value": {
                        "id": "vdl",
                        "kind": "array",
                        "x_scale": {"kind": "linear", "minimum": 200.0, "maximum": 1200.0},
                        "bindings": [
                            {
                                "kind": "raster",
                                "channel": "VDL",
                                "profile": "vdl",
                                "style": {"colormap": "gray_r"}
                            }
                        ]
                    }
                }
            ],
            "allowed_change_paths": ["/sections/0/tracks"],
            "prohibited_change_paths": ["/header", "/remarks", "/page", "/depth", "/output"]
