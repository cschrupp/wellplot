        {
            "id": "duplicate_mirrored_fill",
            "kind": "revise",
            "status": "active",
            "initial_state": {
                "fixture": "open_hole_gr_sp_seed",
                "preconditions": [
                    {
                        "path": "/sections",
                        "operator": "contains_object",
                        "value": {"id": "main", "tracks": [{"id": "depth"}]}
                    }
                ]
            },
            "feedback": "Add a normal `Caliper` track after depth. Bind CALI twice with distinct binding ids: a primary linear 6 to 16 scale and a mirrored linear 6 to 16 scale with reverse true. Add a light-brown `between_instances` fill between the two binding instances.",
            "expected": [
                {
                    "path": "/sections/0/tracks",
                    "operator": "contains_object",
                    "value": {
                        "id": "caliper",
                        "kind": "normal",
                        "bindings": [
                            {
                                "channel": "CALI",
                                "scale": {
                                    "kind": "linear",
                                    "minimum": 6.0,
                                    "maximum": 16.0,
                                    "reverse": false
                                }
                            },
                            {
                                "channel": "CALI",
                                "scale": {
                                    "kind": "linear",
                                    "minimum": 6.0,
                                    "maximum": 16.0,
                                    "reverse": true
                                }
                            }
                        ],
                        "fills": [{"kind": "between_instances", "color": "#c4a484"}]
                    }
                }
            ],
            "allowed_change_paths": ["/sections/0/tracks"],
            "prohibited_change_paths": ["/header", "/remarks", "/page", "/depth", "/output"]
        },
        {
            "id": "array_raster_track",
            "kind": "revise",
            "status": "active",
